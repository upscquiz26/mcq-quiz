# Admin account — created on first start if no admin exists yet.
# After that the password lives (hashed) in the database and these are ignored.
APP_USERNAME=admin
APP_PASSWORD=change-me-please

# Optional: keeps everyone logged in across restarts. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 only if you serve the app over HTTPS (the session cookie is then never sent over plain HTTP).
# SESSION_HTTPS_ONLY=1

# Optional: only if Tesseract isn't on PATH or in its default install folder.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
